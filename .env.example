# Discord Configuration
# For 24/7 bot mode (run.py): set DISCORD_BOT_TOKEN + DISCORD_CHANNEL_ID + DISCORD_USER_ID
# For Cron mode (cron_check.py): set DISCORD_WEBHOOK_URL + DISCORD_USER_ID (or bot token + channel ID)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_USER_ID=123456789012345678

# Optional: Restrict slash commands to a single server for instant command sync
DISCORD_GUILD_ID=

# Tracker Settings
CHECK_INTERVAL_MINUTES=15
ALERT_COOLDOWN_HOURS=12
DB_PATH=data/lego_prices.db
WISHLIST_PATH=wishlist.json
DEV_MODE=false

# UK Shipping Preferences
HAS_AMAZON_PRIME=false
PREFER_CLICK_AND_COLLECT=false

# Optional (£0 Free Tier, No Card Required): SerpApi Key (https://serpapi.com) for Google Shopping UK
# Gives 250 free searches/month across all 8 UK stores (governed automatically so it never runs out early)
SERPAPI_KEY=
SERPAPI_MONTHLY_LIMIT=250

# Optional: Free Brickset API Key (not required; public Brickset lookup works automatically)
BRICKSET_API_KEY=
